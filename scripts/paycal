#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${SCRIPT_DIR}/lib/common.sh"

usage() {
  cat <<'EOF'
PayCal script suite

Usage:
  scripts/paycal <category:action> [args]

Categories:
  hooks:install
  hooks:pre-commit
  hooks:pre-push
  hooks:post-commit
  fix:readme-version
  fix:docblocks
  checks:readme-version
  checks:policy-meta
  checks:test-boundaries
  checks:public-health [public-repo-path]
  ops:github-branch-protection [public|private|both]  # public safety only; no required Actions
  checks:composer-state
  checks:dependency-security
  checks:semantic-diff [--cached|--base-ref REF --head-ref REF] [--paths-file FILE]
  checks:staged-sensitive
  checks:public-promotion-scope [git-range]
  checks:ledger-private
  release:candidate [--allow-dirty]
  release:promote <dev|prod> [sha] [--reason TEXT]
  release:evidence [--target prod.paycal.app]
  ledger:candidate <product> [--allow-dirty]
  ledger:promote <product> <target> [sha] [--reason TEXT]
  ledger:desired <product> <target>
  ledger:status <product> <target>
  ledger:rollback <product> <target>
  ledger:init-product <product>
  deploy:desired <dev|prod>
  deploy:manifest <dev|prod>
  deploy:record-receipt <dev|prod> [--requested-sha SHA] [--checked-out-sha SHA]
  deploy:record-runtime <dev|prod> [--runtime-sha SHA]
  deploy:status [dev|prod]
  deploy:rollback <dev|prod>
  checks:soc2-control-map [path-to-map]
  checks:soc2-evidence-freshness [max-age-days] [path-to-map]
  checks:soc2-change-management [git-range]
  checks:soc2-test-controls
  checks:soc2-auth-runtime [event-limit] [seed-if-empty]
  checks:soc2-export-validate [YYYY-MM]
  checks:edge
  soc2:bundle [YYYY-MM]
  soc2:auditor-index [YYYY-MM] [path-to-map]
  soc2:snapshot [output-markdown-path] [max-age-days]
  soc2:package [YYYY-MM] [output-zip-path]
  crypto:census
  crypto:migrate-plaintext
  business:relationships:audit [--business businessId] [--fix] [--json]
  refactor:fix-headers
  refactor:dedupe-uses
  migrate:redis-field-names
  sync:redis-dev
  tests:affected [base-ref] [head-ref]
  workflow:local [--both] [--yes] [--commit] [--push]

Examples:
  scripts/paycal workflow:local
  scripts/paycal workflow:local --both
  scripts/paycal workflow:local --yes --push
  scripts/paycal hooks:install
  scripts/paycal checks:composer-state
  scripts/paycal checks:dependency-security
  scripts/paycal checks:semantic-diff --cached
  scripts/paycal checks:semantic-diff --base-ref origin/main --head-ref HEAD
  scripts/paycal checks:staged-sensitive
  scripts/paycal checks:public-promotion-scope main...HEAD
  scripts/paycal checks:ledger-private
  scripts/paycal release:candidate
  scripts/paycal release:promote prod --reason "June production release"
  scripts/paycal deploy:status prod
  scripts/paycal checks:soc2-control-map
  scripts/paycal checks:soc2-evidence-freshness 35
  scripts/paycal checks:soc2-change-management main...HEAD
  scripts/paycal checks:soc2-test-controls
  scripts/paycal checks:soc2-auth-runtime 400
  scripts/paycal checks:soc2-auth-runtime 400 0
  scripts/paycal checks:soc2-export-validate 2026-04
  scripts/paycal soc2:bundle 2026-04
  scripts/paycal soc2:snapshot
  scripts/paycal soc2:package 2026-04 /var/www/paycal-soc2-handoff-2026-04-fixed.zip
  scripts/paycal checks:edge
  scripts/paycal crypto:census --json
  scripts/paycal crypto:migrate-plaintext --dry-run
  scripts/paycal business:relationships:audit --json
  scripts/paycal tests:affected origin/main HEAD
EOF
}

cmd="${1:-help}"
shift || true

case "${cmd}" in
  hooks:install)
    exec "${SCRIPT_DIR}/hooks/install.sh" "$@"
    ;;
  hooks:pre-commit)
    exec "${SCRIPT_DIR}/hooks/pre-commit.sh" "$@"
    ;;
  hooks:pre-push)
    exec "${SCRIPT_DIR}/hooks/pre-push.sh" "$@"
    ;;
  hooks:post-commit)
    exec "${SCRIPT_DIR}/hooks/post-commit.sh" "$@"
    ;;
  fix:readme-version)
    exec "${SCRIPT_DIR}/hooks/fix-readme-version.sh" "$@"
    ;;
  fix:docblocks)
    exec "${SCRIPT_DIR}/hooks/fix-docblocks.sh" "$@"
    ;;
  checks:readme-version)
    exec "${SCRIPT_DIR}/hooks/check-readme-version.sh" "$@"
    ;;
  checks:policy-meta)
    exec "${SCRIPT_DIR}/hooks/check-policy-meta.sh" "$@"
    ;;
  checks:test-boundaries)
    exec php "${SCRIPT_DIR}/test/check-test-repo-boundaries.php" "$@"
    ;;
  checks:public-health)
    exec "${SCRIPT_DIR}/check-public-repo-health.sh" "$@"
    ;;
  ops:github-branch-protection)
    exec "${SCRIPT_DIR}/apply-github-branch-protection.sh" "$@"
    ;;
  checks:staged-sensitive)
    exec "${SCRIPT_DIR}/hooks/check-staged-sensitive.sh" "$@"
    ;;
  checks:composer-state)
    exec "${SCRIPT_DIR}/hooks/check-composer-state.sh" "$@"
    ;;
  checks:dependency-security)
    exec "${SCRIPT_DIR}/check-dependency-security.sh" "$@"
    ;;
  checks:semantic-diff)
    exec php "${SCRIPT_DIR}/check-semantic-diff.php" "$@"
    ;;
  checks:public-promotion-scope)
    exec "${SCRIPT_DIR}/check-public-promotion-scope.sh" "$@"
    ;;
  checks:ledger-private)
    exec "${SCRIPT_DIR}/check-release-ledger-private.sh" "$@"
    ;;
  release:candidate)
    exec php "${SCRIPT_DIR}/release-ledger.php" candidate "$@"
    ;;
  release:promote)
    exec php "${SCRIPT_DIR}/release-ledger.php" promote "$@"
    ;;
  release:evidence)
    exec php "${SCRIPT_DIR}/release-ledger.php" evidence "$@"
    ;;
  ledger:candidate)
    product="${1:-}"
    if [ -z "${product}" ]; then
      paycal_log "fatal" "usage: scripts/paycal ledger:candidate <product> [args]"
      exit 2
    fi
    shift
    exec php "${SCRIPT_DIR}/release-ledger.php" candidate --product "${product}" "$@"
    ;;
  ledger:promote)
    exec php "${SCRIPT_DIR}/release-ledger.php" promote "$@"
    ;;
  ledger:desired)
    exec php "${SCRIPT_DIR}/release-ledger.php" desired "$@"
    ;;
  ledger:status)
    exec php "${SCRIPT_DIR}/release-ledger.php" status "$@"
    ;;
  ledger:rollback)
    exec php "${SCRIPT_DIR}/release-ledger.php" rollback "$@"
    ;;
  ledger:init-product)
    exec php "${SCRIPT_DIR}/release-ledger.php" init-product "$@"
    ;;
  deploy:desired)
    exec php "${SCRIPT_DIR}/release-ledger.php" desired "$@"
    ;;
  deploy:manifest)
    exec php "${SCRIPT_DIR}/release-ledger.php" manifest "$@"
    ;;
  deploy:record-receipt)
    exec php "${SCRIPT_DIR}/release-ledger.php" record-receipt "$@"
    ;;
  deploy:record-runtime)
    exec php "${SCRIPT_DIR}/release-ledger.php" record-runtime "$@"
    ;;
  deploy:status)
    exec php "${SCRIPT_DIR}/release-ledger.php" status "$@"
    ;;
  deploy:rollback)
    exec php "${SCRIPT_DIR}/release-ledger.php" rollback "$@"
    ;;
  checks:soc2-control-map)
    exec "${SCRIPT_DIR}/soc2-validate-control-map.sh" "$@"
    ;;
  checks:soc2-evidence-freshness)
    exec "${SCRIPT_DIR}/soc2-evidence-freshness-check.sh" "$@"
    ;;
  checks:soc2-change-management)
    exec "${SCRIPT_DIR}/soc2-export-change-management-trace.sh" "$@"
    ;;
  checks:soc2-test-controls)
    exec "${SCRIPT_DIR}/soc2-export-test-control-trace.sh" "$@"
    ;;
  checks:soc2-auth-runtime)
    exec "${SCRIPT_DIR}/soc2-export-auth-access-runtime-evidence.sh" "$@"
    ;;
  checks:soc2-export-validate)
    exec "${SCRIPT_DIR}/soc2-export-validate.sh" "$@"
    ;;
  checks:edge)
    exec "${SCRIPT_DIR}/get-errors-edge-cases.sh" "$@"
    ;;
  soc2:bundle)
    exec "${SCRIPT_DIR}/soc2-monthly-evidence-bundle.sh" "$@"
    ;;
  soc2:auditor-index)
    exec "${SCRIPT_DIR}/soc2-generate-auditor-index.sh" "$@"
    ;;
  soc2:snapshot)
    exec "${SCRIPT_DIR}/create-soc2-compliance-snapshot.sh" "$@"
    ;;
  soc2:package)
    exec "${SCRIPT_DIR}/soc2-export-package.sh" "$@"
    ;;
  crypto:census)
    exec php "${SCRIPT_DIR}/crypto-census.php" "$@"
    ;;
  crypto:migrate-plaintext)
    exec php "${REPO_ROOT}/copilot-scripts/crypto-migrate-plaintext.php" "$@"
    ;;
  business:relationships:audit)
    exec php "${SCRIPT_DIR}/business-relationships-audit.php" "$@"
    ;;
  refactor:fix-headers)
    exec php "${SCRIPT_DIR}/fix-php-headers.php" "$@"
    ;;
  refactor:dedupe-uses)
    exec php "${SCRIPT_DIR}/remove-duplicate-uses.php" "$@"
    ;;
  migrate:redis-field-names)
    exec php "${SCRIPT_DIR}/migrate-redis-field-names.php" "$@"
    ;;
  sync:redis-dev)
    exec "${REPO_ROOT}/copilot-scripts/redis-sync.sh" "$@"
    ;;
  tests:affected)
    exec php "${SCRIPT_DIR}/test/affected-tests.php" "$@"
    ;;
  workflow:local)
    exec "${SCRIPT_DIR}/local-workflow.sh" "$@"
    ;;
  help|-h|--help|list)
    usage
    ;;
  *)
    paycal_log "fatal" "unknown command: ${cmd}"
    usage
    exit 2
    ;;
esac
